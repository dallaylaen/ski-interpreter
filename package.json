{
  "name": "@dallaylaen/ski-interpreter",
  "version": "3.0.0",
  "description": "Simple Kombinator Interpreter - a combinatory logic & lambda calculus parser and interpreter. Supports SKI, BCKW, Church numerals, and setting up assertions ('quests') involving all of the above.",
  "keywords": [
    "combinatory logic",
    "lambda calculus",
    "functional programming",
    "education",
    "interpreter"
  ],
  "type": "commonjs",
  "main": "lib/ski-interpreter.cjs.js",
  "module": "lib/ski-interpreter.mjs",
  "exports": {
    "types": "./lib/types/index.d.ts",
    "types/*": "./lib/types/*.d.ts",
    "import": "./lib/ski-interpreter.mjs",
    "require": "./lib/ski-interpreter.cjs.js"
  },
  "bin": {
    "ski": "bin/ski.js"
  },
  "scripts": {
    "lint": "npx eslint --ext .js,.ts src test bin",
    "tsc": "npx tsc",
    "test": "npm run tsc; npx nyc mocha --recursive test/unit",
    "test:int": "npx mocha --recursive test/integration",
    "tsdoc": "npx typedoc --treatWarningsAsErrors --out docs/man --gitRevision \"$(git log -1 --format='%H' -- src/)\" src/*.ts",
    "bundle:web": "npx esbuild --bundle --minify --sourcemap --format=iife ./src/index.ts --outfile=docs/build/js/ski-interpreter.min.js",
    "bundle:cjs": "npx esbuild --bundle --sourcemap --format=cjs ./src/index.ts --outfile=lib/ski-interpreter.cjs.js",
    "bundle:esm": "npx esbuild --bundle --sourcemap --format=esm ./src/index.ts --outfile=lib/ski-interpreter.mjs",
    "bundle:site": "npx esbuild --bundle --minify --sourcemap ./site-src/index.js --outfile=docs/build/js/util.min.js",
    "bundle:quest": "npx esbuild --bundle --minify --sourcemap --format=iife ./site-src/index-quest.js --outfile=docs/build/js/ski-quest.min.js",
    "bundle": "npm run bundle:cjs && npm run bundle:esm && npm run bundle:web && npm run bundle:site && npm run bundle:quest",
    "check": "npm run lint && npm run tsc && npm run test",
    "build": "npm run check && npm run bundle && npm run test:int",
    "prepack": "rm -rf lib docs/build && npm run build && cp docs/build/js/ski-* lib/"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "example",
    "quest-authoring.md",
    "lib",
    "!lib/types/test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallaylaen/ski-interpreter.git"
  },
  "author": "Konstantin Uvarin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dallaylaen/ski-interpreter/issues"
  },
  "homepage": "https://dallaylaen.github.io/ski-interpreter/index.html",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "chai": "^4.3.7",
    "esbuild": "^0.25.10",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-align-assignments": "^1.1.2",
    "eslint-plugin-import": "^2.29.1",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.18",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
